# --- Secrets: never commit ---
translate_config.json
.env
.env.local
scripts/.env
scripts/.changelog_pusher_state.json


# --- Scraped data & caches (large, regenerable, backed up separately) ---
gevi.db
gevi.db-shm
gevi.db-wal
gevi.db.backup-*
# Manual pre-scrape copies (`cp gevi.db backups/gevi-<date>.db`). Deliberately not
# named gevi.db.backup-* so the scraper's own prune (keep=5) cannot delete them.
backups/
image_cache/

# --- 刮削脚本的运行日志 ---
logs/
# 长任务是从项目根目录 nohup 起的，日志和 pid 就落在根目录，不在 logs/ 里。
# 只锚定根目录，免得顺手挡掉别处的 .log。
/*.log
/*.pid

# --- Python ---
__pycache__/
*.py[cod]

# --- Node / frontend build ---
node_modules/
desktop_client/dist/
desktop_client/node_modules/

# --- Tauri build artifacts ---
desktop_client/src-tauri/target/
*.dmg

# --- Android build artifacts & signing keys ---
android_client/app/build/
android_client/target/
android_client/node_modules/
*.keystore
*.jks

# --- macOS / editors ---
.DS_Store
.vscode/
.idea/
